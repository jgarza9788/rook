# omanta — native Qt Quick/GIO file manager for Omarchy.
#
# Builds the release commit, pinned by hash and checksummed: a tag can be
# moved after the fact, a commit cannot. Releasing a new version means
# updating pkgver, _commit (git rev-parse v$pkgver^{commit}) and the
# checksum (makepkg -g), then publishing SHA256SUMS beside the package:
#   sha256sum omanta-*.pkg.tar.zst > SHA256SUMS
# For a local test build from your working tree, swap source= for
# "$pkgname::git+file://<repo-path>", set sha256sums=('SKIP') and add back
#   pkgver() { cd "$pkgname"; printf "0.r%s.%s" \
#     "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"; }
#
# Deliberately NOT shipped here (cutover-only, see NOTES.md):
#   /usr/share/dbus-1/services/org.freedesktop.FileManager1.service
# pacman would refuse to install alongside nautilus, which owns it. The
# runtime claims the name only when free, so both coexist until cutover.

pkgname=omanta
pkgver=0.1.23
pkgrel=1
pkgdesc="Native file manager for Omarchy (Qt Quick + GIO)"
arch=('x86_64' 'aarch64')
url="https://github.com/28allday/omanta"
license=('MIT')
install="$pkgname.install"
# qt6-multimedia and qt6-webengine (Qt Pdf) power the quick view's audio/video
# and PDF pages; they are linked when present at build time, so they are hard
# dependencies of this package. -DOMANTA_WITH_MEDIA/PDF=OFF drops them.
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'glib2' 'gvfs' 'hicolor-icon-theme'
         'libarchive' 'tinysparql' 'qt6-multimedia' 'qt6-webengine')
optdepends=('gvfs-smb: browse smb:// shares'
            'gvfs-mtp: phones over MTP'
            'gvfs-gphoto2: cameras'
            'ffmpegthumbnailer: video thumbnails'
            'localsearch: full-text search'
            'sushi: Space previews through Sushi (Preferences → Space Previews With)')
makedepends=('cmake' 'ninja' 'git')
_commit=20fbae8b56b8f02547ff4d4486af541d4a646f2f # v0.1.23
source=("$pkgname::git+https://github.com/28allday/omanta.git#commit=$_commit")
sha256sums=('3b316dfbda5bc940ac8588752b663b387b7d72d011a1420c4d01ea894ebd00be')

build() {
    # Tests off: the public tree carries them, but a package build has no
    # business compiling the test binaries, and there is no check().
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DOMANTA_BUILD_TESTS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
